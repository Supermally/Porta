From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: Apple Gaming Compatibility Runtime Team <runtime@porta.apple>
Date: Sun, 23 Aug 2026 00:00:00 +0000
Subject: [PATCH] ntdll: Support 16KB page size memory allocation on Apple Silicon macOS

Apple Silicon uses a 16KB hardware memory page size while Windows x86_64
assumes 4KB pages. Align virtual allocations to 16KB boundaries to avoid
KERN_INVALID_ADDRESS faults when running under Rosetta 2 and native ARM64.
---
 dlls/ntdll/unix/virtual.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 0000000..1111111 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -42,6 +42,20 @@
 
+#if defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))
+/* Apple Silicon macOS uses 16KB pages */
+#define HOST_PAGE_SIZE 0x4000
+#define HOST_PAGE_MASK 0x3FFF
+#else
+/* Standard 4KB page size */
+#define HOST_PAGE_SIZE 0x1000
+#define HOST_PAGE_MASK 0x0FFF
+#endif
+
 static void *round_to_host_page( void *addr )
 {
+    uintptr_t val = (uintptr_t)addr;
+    return (void *)((val + HOST_PAGE_MASK) & ~HOST_PAGE_MASK);
 }
 
